@using Application.Constants
@model EnquiryViewModel
@{
    ViewBag.Title = "Enquiries";

    var email = Model.Email!;
    var enquiries = Model.Enquiries!;
}

@section Title
{
    @switch (email.Purpose)
    {
        case EnquiryTypes.CareerApplication:
            <text>Career enquiries</text>
            break;

        case EnquiryTypes.Newsletter:
            <text>Newsletter Subscription</text>
            break;

        default:
            <text>General enquiries</text>
            break;
    }
}

<div class="row">
    <div class="col-12">
        <div class="card">

            <div class="card-body" id="ModalUser">
                @using (Html.BeginForm("PostEmail", "Enquiry", FormMethod.Post, new { enctype = "multipart/form-data" }))
                {
                    // ReSharper disable once LocalVariableHidesMember InconsistentNaming
                    var Model = email;


                    <div class="modal-body row">

                        <input type="hidden" asp-for="@Model.Purpose"/>
                        <div class="mb-3 col-md-6">
                            <label class="col-form-label">SMTP Server</label>
                            <input type="text" class="form-control" asp-for="@Model.SmtpServer">
                        </div>

                        <div class="mb-3 col-md-6">
                            <label class="col-form-label">Port</label>
                            <input type="number" class="form-control" asp-for="@Model.Port">
                        </div>

                        <div class="mb-3 col-md-6">
                            <label class="col-form-label">Sender Email ID</label>
                            <input type="text" class="form-control" asp-for="@Model.EmailId">
                        </div>

                        <div class="mb-3 col-md-6">
                            <label class="col-form-label">Password</label>
                            <input type="password" class="form-control" asp-for="@Model.Password" value="@Model.Password">
                        </div>

                        <div class="mb-3 col-md-12">
                            <label class="col-form-label">Recipients(Multiple recipients? Seperate each email with a comma[,])</label>
                            <textarea class="form-control" asp-for="@Model.Recipients"></textarea>
                        </div>

                        <div class="btn-group">
                            <button type="submit" id="formsubmit" class="btn btn-primary">Save changes</button>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>



<div class="row mb-3">
    <div class="col-12">
        <div class="card">
            <div class="card-header bg-light">
                <h5 class="card-title mb-0"><i class="fas fa-filter"></i> Filter & Bulk Export Enquiries</h5>
            </div>
            <div class="card-body">
                <form method="get" action="/admin/enquiry" id="filterForm">
                    <input type="hidden" name="type" value="@email.Purpose" />
                    <div class="row align-items-end">
                        @if (email.Purpose == EnquiryTypes.CareerApplication)
                        {
                            <div class="col-md-3 mb-2">
                                <label class="form-label font-weight-bold">Job Position:</label>
                                <select name="careerId" class="form-control">
                                    <option value="">-- All Positions --</option>
                                    @if (Model.Careers != null)
                                    {
                                        @foreach (var c in Model.Careers)
                                        {
                                            if (Model.SelectedCareerId == c.Id)
                                            {
                                                <option value="@c.Id" selected>@c.TitleEnglish</option>
                                            }
                                            else
                                            {
                                                <option value="@c.Id">@c.TitleEnglish</option>
                                            }
                                        }
                                    }
                                </select>
                            </div>
                        }
                        <div class="col-md-3 mb-2">
                            <label class="form-label font-weight-bold">Start Date:</label>
                            <input type="date" name="startDate" class="form-control" value="@(Model.StartDate?.ToString("yyyy-MM-dd"))" />
                        </div>
                        <div class="col-md-3 mb-2">
                            <label class="form-label font-weight-bold">End Date:</label>
                            <input type="date" name="endDate" class="form-control" value="@(Model.EndDate?.ToString("yyyy-MM-dd"))" />
                        </div>
                        <div class="col-md-3 mb-2 d-flex gap-2">
                            <button type="submit" class="btn btn-primary me-2"><i class="fas fa-search"></i> Filter</button>
                            <a href="/admin/enquiry?type=@email.Purpose" class="btn btn-secondary me-2"><i class="fas fa-undo"></i> Reset</a>
                            <button type="button" onclick="exportData()" class="btn btn-success"><i class="fas fa-file-export"></i> Export CSV</button>
                        </div>
                    </div>
                </form>

                <form id="exportForm" method="post" action="/admin/enquiry/export" style="display:none;">
                    <input type="hidden" name="type" value="@email.Purpose" />
                    <input type="hidden" name="careerId" value="@Model.SelectedCareerId" />
                    <input type="hidden" name="startDate" value="@(Model.StartDate?.ToString("yyyy-MM-dd"))" />
                    <input type="hidden" name="endDate" value="@(Model.EndDate?.ToString("yyyy-MM-dd"))" />
                    <input type="hidden" name="selectedIds" id="exportSelectedIds" value="" />
                </form>
            </div>
        </div>
    </div>
</div>

@if (enquiries.Any() && email.Purpose == EnquiryTypes.General)
{
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h4 class="card-title">
                        General enquiries
                    </h4>
                </div>
                <div class="card-body">
                    <table id="datatable" class="table table-striped dt-responsive nowrap w-100">
                        <thead>
                        <tr>
                            <th width="5%"><input type="checkbox" id="selectAllEnquiries" onclick="toggleSelectAll(this)" /></th>
                            <th width="28%">Name</th>
                            <th width="28%">Email</th>
                            <th width="28%">Sent on</th>
                            <th width="11%">Action</th>
                        </tr>
                        </thead>
                        <tbody>
                        @foreach (var item in enquiries)
                        {
                            <tr>
                                <td><input type="checkbox" class="enquiry-checkbox" value="@item.Id" /></td>
                                <td>@Html.Raw(item.Name)</td>
                                <td>@Html.Raw(item.Email)</td>
                                <td>@Html.Raw(item.CreatedOn?.ToShortDateString())</td>
                                <td>
                                    <a asp-action="Get" asp-route-id="@item.Id"
                                       class="btn btn-primary btn-xs">
                                        <i class="fas fa-pencil-alt"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
}
@if (enquiries.Any() && email.Purpose == EnquiryTypes.CareerApplication)
{
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h4 class="card-title">
                        Career enquiries
                    </h4>
                </div>
                <div class="card-body">
                    <table id="datatable" class="table table-striped dt-responsive nowrap w-100">
                        <thead>
                            <tr>
                                <th width="5%"><input type="checkbox" id="selectAllEnquiries" onclick="toggleSelectAll(this)" /></th>
                                <th width="15%">First Name</th>
                                <th width="15%">Last Name</th>
                                <th width="20%">Post</th>
                                <th width="25%">Email</th>
                                <th width="10%">Sent on</th>
                                <th width="10%">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in enquiries)
                            {
                                <tr>
                                    <td><input type="checkbox" class="enquiry-checkbox" value="@item.Id" /></td>
                                    <td>@Html.Raw(item.FirstName)</td>
                                    <td>@Html.Raw(item.LastName)</td>
                                    @if(Model.Careers.FirstOrDefault(x => x.Id == item.EntityId) != null)
                                    {
                                        <td>@Model.Careers.FirstOrDefault(x => x.Id == item.EntityId).TitleEnglish</td>
                                    }
                                    else
                                    {
                                        <td></td>
                                    }
                                    <td>@Html.Raw(item.Email)</td>
                                    <td>@Html.Raw(item.CreatedOn?.ToShortDateString())</td>
                                    <td>
                                        <a asp-action="Get" asp-route-id="@item.Id"
                                           class="btn btn-primary btn-xs">
                                            <i class="fas fa-pencil-alt"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
}
@if (enquiries.Any() && email.Purpose == EnquiryTypes.Newsletter)
{
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h4 class="card-title">
                        Newsletter Subscriptions
                    </h4>
                </div>
                <div class="card-body">
                    <table id="datatable" class="table table-striped dt-responsive nowrap w-100">
                        <thead>
                            <tr>
                                <th width="5%"><input type="checkbox" id="selectAllEnquiries" onclick="toggleSelectAll(this)" /></th>
                                <th width="40%">Email</th>
                                <th width="30%">Sent on</th>
                                <th width="25%">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in enquiries)
                            {
                                <tr>
                                    <td><input type="checkbox" class="enquiry-checkbox" value="@item.Id" /></td>
                                    <td>@Html.Raw(item.Email)</td>
                                    <td>@Html.Raw(item.CreatedOn?.ToShortDateString())</td>
                                    <td>
                                        <a asp-action="Get" asp-route-id="@item.Id"
                                           class="btn btn-primary btn-xs">
                                            <i class="fas fa-pencil-alt"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
}

<script>
    function toggleSelectAll(master) {
        var checkboxes = document.querySelectorAll('.enquiry-checkbox');
        checkboxes.forEach(function(cb) {
            cb.checked = master.checked;
        });
    }

    function exportData() {
        var selected = [];
        document.querySelectorAll('.enquiry-checkbox:checked').forEach(function(cb) {
            selected.push(cb.value);
        });

        document.getElementById('exportSelectedIds').value = selected.join(',');
        document.getElementById('exportForm').submit();
    }
</script>