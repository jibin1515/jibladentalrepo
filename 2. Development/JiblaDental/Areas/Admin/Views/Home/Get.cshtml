@model HomeBannerDto
@section Title
{
    <a asp-action="GetAll" class="btn btn-primary btn-xs"><i class="fas fa-arrow-left"></i></a>Entry
}
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-body" id="ModalUser">
                @using (Html.BeginForm("Post", "Home", FormMethod.Post, new { enctype = "multipart/form-data" }))
                {
                    <div class="modal-body row">
                        <input type="hidden" asp-for="@Model.Id">
                        <div class="mb-3 col-md-12">
                            <label class="col-form-label">Tagline(English)</label>
                            <input type="text" class="form-control" asp-for="@Model.TaglineEnglish">
                        </div>
                        <div class="mb-3 col-md-12">
                            <label class="col-form-label">Tagline(Arabic)</label>
                            <input type="text" class="form-control" asp-for="@Model.TaglineArabic" dir="rtl">
                        </div>
                        <div class="mb-3 col-md-12">
                            <label class="col-form-label">Title(English)</label><input type="text" class="form-control" asp-for="@Model.TitleEnglish">
                        </div>
                        <div class="mb-3 col-md-12">
                            <label class="col-form-label">Title(Arabic)</label><input type="text" class="form-control" asp-for="@Model.TitleArabic" dir="rtl">
                        </div>
                        <div class="mb-3 col-md-12">
                            <label class="col-form-label">Body(English)</label>
                            <textarea class="mceDescrEng" asp-for="@Model.BodyEnglish"></textarea>
                        </div>
                        <div class="mb-3 col-md-12">
                            <label class="col-form-label">Body(Arabic)</label><textarea class="mceDescrArb" asp-for="@Model.BodyArabic" dir="rtl"></textarea>
                        </div>
                        <div class="mb-3 col-md-12">
                            <label class="col-form-label">Image (1920 x 1080)</label>
                            @if (!string.IsNullOrEmpty(Model.ImagePath))
                            {
                                <br />
                                <img src="/@Model.ImagePath" width="150" alt="image-preview" />
                                <br />
                            }
                            <input type="hidden" asp-for="@Model.ImagePath">
                            <input type="file" class="form-control" asp-for="@Model.Image">
                            <label class="col-form-label">Image alt</label>
                            <input type="text" class="form-control" asp-for="@Model.ImageAlt">
                        </div>
                        <div class="mb-3 col-md-12">
                            <label class="col-form-label">Button Title(English)</label><input type="text" class="form-control" asp-for="@Model.ButtonTitleEnglish">
                        </div>
                        <div class="mb-3 col-md-12">
                            <label class="col-form-label">Button Title(Arabic)</label><input type="text" class="form-control" asp-for="@Model.ButtonTitleArabic" dir="rtl">
                        </div>
                        <div class="mb-3 col-md-12">
                            <label class="col-form-label">Button Url</label><input type="text" class="form-control" asp-for="@Model.ButtonUrl">
                        </div>
                        @if (Model.Id is > 0)
                        {
                            <div class="mb-3 col-md-12">
                                <label class="col-form-label">Display Order</label>
                                <input type="number" min="1" class="form-control" asp-for="@Model.DisplayOrder">
                            </div>
                        }
                        <div class="mb-3 col-md-12">
                            <label class="form-check-label">Enabled</label><input asp-for="@Model.IsActive" type="checkbox" class="form-check-input" />
                        </div>
                        <div class="btn-group">
                            @if (Model.Id is > 0)
                            {
                                <button asp-action="Delete" asp-route-id="@Model.Id" onclick="return confirm('Are you sure you want to delete this entity?')" class="btn btn-danger">Delete</button>
                            }
                            <button type="submit" id="formsubmit" class="btn btn-primary">Save changes</button>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
