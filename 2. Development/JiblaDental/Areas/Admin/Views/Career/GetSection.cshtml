@model CareerViewModel
@{
    var section = Model.Section;
}
@section Title
{
        Career management
}
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-body" id="ModalUser">
                @using (Html.BeginForm("PostSection", "Career", FormMethod.Post, new { enctype = "multipart/form-data" }))
                {
                    var Model = section!;
                    <div class="modal-body row">
                        <div class="mb-3 col-md-12">
                            <label class="col-form-label">Title(English)</label>
                            <input type="text" class="form-control" asp-for="@Model.TitleEnglish">
                        </div>
                        <div class="mb-3 col-md-12">
                            <label class="col-form-label">Title(Arabic)</label>
                            <input type="text" class="form-control" asp-for="@Model.TitleArabic" dir="rtl">
                        </div>
                       @*  <div class="mb-3 col-md-12">
                            <label class="col-form-label">Form Title(English)</label>
                            <input type="text" class="form-control" asp-for="@Model.FormTitleEnglish">
                        </div>
                        <div class="mb-3 col-md-12">
                            <label class="col-form-label">Form Title(Arabic)</label>
                            <input type="text" class="form-control" asp-for="@Model.FormTitleArabic" dir="rtl">
                        </div> *@
                        <div class="btn-group">
                            <button type="submit" id="formsubmit" class="btn btn-primary">Save changes</button>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <a asp-action="Get" asp-route-id="0" class="btn btn-primary btn-xs">New</a>
            </div>
            <div class="card-body">
                <table id="datatable" class="table table-striped dt-responsive nowrap w-100">
                    <thead>
                        <tr>
                            <th width="40%">Title</th>
                            <th width="20%">Status</th>
                            <th width="20%">Display Order</th>
                            <th width="20%">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Careers)
                        {
                            <tr>
                                <td>@Html.Raw(item.TitleEnglish)</td>
                                <td>@Html.Raw(item.IsActive ? "Enabled" : "Disabled")</td>
                                <td>@Html.Raw(item.DisplayOrder)</td>
                                <td>
                                    <a asp-action="Get" asp-route-id="@item.Id" class="btn btn-primary btn-xs">
                                        <i class="fas fa-pencil-alt"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>