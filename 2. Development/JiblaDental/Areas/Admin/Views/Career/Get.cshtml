@model CareerViewModel

@{
    var career = Model.Career!;
    var content = Model.CareersContent!;
}
@section Title
{
    <a asp-action="GetSection" class="btn btn-primary btn-xs">
        <i class="fas fa-arrow-left"></i>
    </a>
        Entry
}
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-body" id="ModalUser">
                @using (Html.BeginForm("Post", "Career", FormMethod.Post, new { enctype = "multipart/form-data" }))
                {
                    var Model = career;
                    <div class="modal-body row">
                        <input type="hidden" asp-for="@Model.Id">
                        <div class="mb-3 col-md-12">
                            <label class="col-form-label">Title (English)</label>
                            <input type="text" class="form-control" asp-for="@Model.TitleEnglish">
                        </div>
                        <div class="mb-3 col-md-12">
                            <label class="col-form-label">Title (Arabic)</label>
                            <input type="text" class="form-control" asp-for="@Model.TitleArabic" dir="rtl">
                        </div>
                        <div class="mb-3 col-md-12">
                            <label class="col-form-label">Body (English)</label>
                            <textarea class="mceDescrEng" asp-for="@Model.BodyEnglish"></textarea>
                        </div>
                        <div class="mb-3 col-md-12">
                            <label class="col-form-label">Body (Arabic)</label>
                            <textarea class="mceDescrArb" asp-for="@Model.BodyArabic" dir="rtl"></textarea>
                        </div>
                        <div class="mb-3 col-md-12">
                            <label class="col-form-label">Short Body (English)</label>
                            <textarea class="mceDescrEng" asp-for="@Model.ShortBodyEnglish"></textarea>
                        </div>
                        <div class="mb-3 col-md-12">
                            <label class="col-form-label">Short Body (Arabic)</label>
                            <textarea class="mceDescrArb" asp-for="@Model.ShortBodyArabic" dir="rtl"></textarea>
                        </div>
                        <div class="mb-3 col-md-12">
                            <label class="col-form-label">Title 2 (English)</label>
                            <input type="text" class="form-control" asp-for="@Model.Title2English">
                        </div>
                        <div class="mb-3 col-md-12">
                            <label class="col-form-label">Title 2 (Arabic)</label>
                            <input type="text" class="form-control" asp-for="@Model.Title2Arabic" dir="rtl">
                        </div>
                        <div class="mb-3 col-md-12">
                            <label class="col-form-label">Body 2 (English)</label>
                            <textarea class="mceDescrEng" asp-for="@Model.Body2English"></textarea>
                        </div>
                        <div class="mb-3 col-md-12">
                            <label class="col-form-label">Body 2 (Arabic)</label>
                            <textarea class="mceDescrArb" asp-for="@Model.Body2Arabic" dir="rtl"></textarea>
                        </div>
                        <div class="mb-3 col-md-12">
                            <label class="col-form-label">Title 3 (English)</label>
                            <input type="text" class="form-control" asp-for="@Model.Title3English">
                        </div>
                        <div class="mb-3 col-md-12">
                            <label class="col-form-label">Title 3 (Arabic)</label>
                            <input type="text" class="form-control" asp-for="@Model.Title3Arabic" dir="rtl">
                        </div>
                        <div class="mb-3 col-md-12">
                            <label class="col-form-label">Body 3 (English)</label>
                            <textarea class="mceDescrEng" asp-for="@Model.Body3English"></textarea>
                        </div>
                        <div class="mb-3 col-md-12">
                            <label class="col-form-label">Body 3 (Arabic)</label>
                            <textarea class="mceDescrArb" asp-for="@Model.Body3Arabic" dir="rtl"></textarea>
                        </div>
                        <div class="mb-3 col-md-12">
                            <label class="col-form-label">Job Type (English)</label>
                            <input type="text" class="form-control" asp-for="@Model.JobTypeEnglish">
                        </div>
                        <div class="mb-3 col-md-12">
                            <label class="col-form-label">Job Type (Arabic)</label>
                            <input type="text" class="form-control" asp-for="@Model.JobTypeArabic" dir="rtl">
                        </div>
                        <div class="mb-3 col-md-12">
                            <label class="col-form-label">Email</label>
                            <input type="text" class="form-control" asp-for="@Model.Email">
                        </div>
                        @* <div class="mb-3 col-md-12">
                            <label class="col-form-label">Vacancy</label>
                            <input type="number" class="form-control" asp-for="@Model.Vacancy">
                        </div> *@
                        <div class="mb-3 col-md-12">
                            <label class="col-form-label">Icon (512 x 512)</label>
                            @if (!string.IsNullOrEmpty(Model.IconPath))
                            {
                                <br />
                                <img src="/@Model.IconPath" width="150" alt="image-preview" />
                                <br />
                            }
                            <input type="hidden" asp-for="@Model.IconPath">
                            <input type="file" class="form-control" asp-for="@Model.Icon">
                            <label class="col-form-label">Icon Alt</label>
                            <input type="number" class="form-control" asp-for="@Model.IconAlt">
                        </div>
                        @* <div class="mb-3 col-md-12">
                            <label class="col-form-label">Banner Title(English)</label>
                            <input type="text" class="form-control" asp-for="@Model.BannerTitleEnglish">
                        </div>
                        <div class="mb-3 col-md-12">
                            <label class="col-form-label">Banner Title(Arabic)</label>
                            <input type="text" class="form-control" asp-for="@Model.BannerTitleArabic" dir="rtl">
                        </div>
                        <div class="mb-3 col-md-12">
                            <label class="col-form-label">Banner image (1920 x 490)</label>
                            @if (!string.IsNullOrEmpty(Model.BannerImagePath))
                            {
                                <br />
                                <img src="/@Model.BannerImagePath" width="150" alt="image-preview" />
                                <br />
                            }
                            <input type="hidden" asp-for="@Model.BannerImagePath">
                            <input type="file" class="form-control" asp-for="@Model.BannerImage">
                        </div> *@
                        @if (Model.Id > 0)
                        {
                            <br />
                            <br />
                            <div class="card-header">
                                <h4 class="card-title">Page settings</h4>
                            </div>

                            <div class="mb-3 col-md-12">
                                <label class="col-form-label">Page name(Shown on the URL)</label>
                                <input type="text" class="form-control" asp-for="@Model.PageName">
                            </div>

                            <div class="mb-3 col-md-12">
                                <label class="col-form-label">SEO Title (English)</label>
                                <input type="text" class="form-control" asp-for="@Model.SeoTitleEnglish">
                            </div>

                            <div class="mb-3 col-md-12">
                                <label class="col-form-label">SEO Title (Arabic)</label>
                                <input type="text" class="form-control" asp-for="@Model.SeoTitleArabic">
                            </div>

                            <div class="mb-3 col-md-12">
                                <label class="col-form-label">SEO Description (English)</label>
                                <textarea class="form-control" asp-for="@Model.SeoDescriptionEnglish"></textarea>
                            </div>

                            <div class="mb-3 col-md-12">
                                <label class="col-form-label">SEO Description (Arabic)</label>
                                <textarea class="form-control" asp-for="@Model.SeoDescriptionArabic"></textarea>
                            </div>

                            <div class="mb-3 col-md-12">
                                <label class="col-form-label">Display Order</label>
                                <input type="number" min="1" class="form-control" asp-for="@Model.DisplayOrder">
                            </div>
                        }
                        <div class="mb-3 col-md-12">
                            <label class="form-check-label">Enabled</label>
                            <input asp-for="@Model.IsActive" type="checkbox" class="form-check-input" />
                        </div>
                        <div class="btn-group">
                            @if (Model.Id is > 0)
                            {
                                <button asp-action="Delete" asp-route-id="@Model.Id" onclick="return confirm('Are you sure you want to delete this entity?')" class="btn btn-danger">Delete</button>
                            }
                            <button type="submit" id="formsubmit" class="btn btn-primary">Save changes</button>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@if (Model.Career.Id > 0)
{
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h4 class="card-title">
                        Extra Details
                    </h4>
                    <a asp-action="GetContent" asp-route-id="0" asp-route-careerId="@Model.Career.Id" class="btn btn-primary btn-xs">New</a></div><div class="card-body">
                    <table id="datatable" class="table table-striped dt-responsive nowrap w-100">
                        <thead><tr><th width="40%">Title</th><th width="20%">Status</th><th width="20%">Display Order</th><th width="20%">Action</th></tr></thead>
                        <tbody>
                            @foreach (var item in Model.CareersContent)
                            {
                                <tr>
                                    <td>@Html.Raw(item.TitleEnglish)</td>
                                    <td>@Html.Raw(item.IsActive ? "Enabled" : "Disabled")</td>
                                    <td>@Html.Raw(item.DisplayOrder)</td>
                                    <td><a asp-action="GetContent" asp-route-id="@item.Id" class="btn btn-primary btn-xs"><i class="fas fa-pencil-alt"></i></a></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
}