@model ServiceDto
@section Title
{
    <a asp-action="GetSection" class="btn btn-primary btn-xs">
        <i class="fas fa-arrow-left"></i>
    </a>
Entry
}
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-body" id="ModalUser">
                @using (Html.BeginForm("Post", "Service", FormMethod.Post, new { enctype = "multipart/form-data" }))
                {
                    <div class="modal-body row">
                        <input type="hidden" asp-for="@Model.Id">
                        <div class="mb-3 col-md-12">
                            <label class="col-form-label">Title(English)</label>
                            <input type="text" class="form-control" asp-for="@Model.TitleEnglish">
                        </div>
                        <div class="mb-3 col-md-12">
                            <label class="col-form-label">Title(Arabic)</label>
                            <input type="text" class="form-control" asp-for="@Model.TitleArabic" dir="rtl">
                        </div>
                        <div class="mb-3 col-md-12">
                            <label class="col-form-label">Body(English)</label>
                            <textarea class="mceDescrEng" asp-for="@Model.BodyEnglish"></textarea>
                        </div>
                        <div class="mb-3 col-md-12">
                            <label class="col-form-label">Body(Arabic)</label>
                            <textarea class="mceDescrArb" asp-for="@Model.BodyArabic" dir="rtl"></textarea>
                        </div>
                        <div class="mb-3 col-md-12">
                            <label class="col-form-label">Short Body(English)</label>
                            <textarea class="mceDescrEng" asp-for="@Model.ShortBodyEnglish"></textarea>
                        </div>
                        <div class="mb-3 col-md-12">
                            <label class="col-form-label">Short Body(Arabic)</label>
                            <textarea class="mceDescrArb" asp-for="@Model.ShortBodyArabic" dir="rtl"></textarea>
                        </div>
                        <div class="mb-3 col-md-12">
                            <label class="col-form-label">Image (1024 x 610)</label>
                            @if (!string.IsNullOrEmpty(Model.ImagePath))
                            {
                                <br />

                                <img src="/@Model.ImagePath" width="150" alt="image-preview" />

                                <br />
                            }
                            <input type="hidden" asp-for="@Model.ImagePath">
                            <input type="file" class="form-control" asp-for="@Model.Image">
                            <label class="col-form-label">Image alt</label>
                            <input type="text" class="form-control" asp-for="@Model.ImageAlt">
                        </div>
                        <div class="mb-3 col-md-12">
                            <label class="col-form-label">Home Image (1000 x 860)</label>
                            @if (!string.IsNullOrEmpty(Model.HomeImagePath))
                            {
                                <br />

                                <img src="/@Model.HomeImagePath" width="150" alt="image-preview" />

                                <br />
                            }
                            <input type="hidden" asp-for="@Model.HomeImagePath">
                            <input type="file" class="form-control" asp-for="@Model.HomeImage">
                            <label class="col-form-label">HomeImage alt</label>
                            <input type="text" class="form-control" asp-for="@Model.HomeImageAlt">
                        </div>
                        <div class="mb-3 col-md-12">
                            <label class="col-form-label">Icon (28 x 23)</label>
                            @if (!string.IsNullOrEmpty(Model.IconPath))
                            {
                                <br />

                                <img src="/@Model.IconPath" width="150" alt="image-preview" />

                                <br />
                            }
                            <input type="hidden" asp-for="@Model.IconPath">
                            <input type="file" class="form-control" asp-for="@Model.Icon">
                            <label class="col-form-label">Icon alt</label>
                            <input type="text" class="form-control" asp-for="@Model.IconAlt">
                        </div>

                        <div class="mb-3 col-md-12">
                            <label class="col-form-label">Banner Title(English)</label>
                            <input type="text" class="form-control" asp-for="@Model.BannerTitleEnglish">
                        </div>
                        <div class="mb-3 col-md-12">
                            <label class="col-form-label">Banner Title(Arabic)</label>
                            <input type="text" class="form-control" asp-for="@Model.BannerTitleArabic" dir="rtl">
                        </div>
                        <div class="mb-3 col-md-12">
                            <label class="col-form-label">Banner image (1920 x 490)</label>
                            @if (!string.IsNullOrEmpty(Model.BannerImagePath))
                            {
                                <br />
                                <img src="/@Model.BannerImagePath" width="150" alt="image-preview" />
                                <br />
                            }
                            <input type="hidden" asp-for="@Model.BannerImagePath">
                            <input type="file" class="form-control" asp-for="@Model.BannerImage">
                            <label class="col-form-label">Banner Image Alt</label>
                            <input type="text" class="form-control" asp-for="@Model.BannerImageAlt">
                        </div>                        
                        <div class="mb-3 col-md-12">
                            <label class="form-check-label">Show On Home Page?</label>
                            <input asp-for="@Model.ShowOnHomePage" type="checkbox" class="form-check-input" />
                        </div>
                        @if (Model.Id > 0)
                        {
                            <br />

                            <br />

                            <div class="card-header"><h4 class="card-title">Page settings</h4></div>

                            <div class="mb-3 col-md-12"><label class="col-form-label">Page name(Shown on the URL)</label><input type="text" class="form-control" asp-for="@Model.PageName"></div>

                            <div class="mb-3 col-md-6"><label class="col-form-label">SEO Title (English)</label><input type="text" class="form-control" asp-for="@Model.SeoTitleEnglish"></div>

                            <div class="mb-3 col-md-6"><label class="col-form-label">SEO Title (Arabic)</label><input type="text" class="form-control" asp-for="@Model.SeoTitleArabic"></div>

                            <div class="mb-3 col-md-6"><label class="col-form-label">SEO Description (English)</label><textarea class="form-control" asp-for="@Model.SeoDescriptionEnglish"></textarea></div>

                            <div class="mb-3 col-md-6"><label class="col-form-label">SEO Description (Arabic)</label><textarea class="form-control" asp-for="@Model.SeoDescriptionArabic"></textarea></div>

                            <div class="mb-3 col-md-12"><label class="col-form-label">Display Order</label><input type="number" min="1" class="form-control" asp-for="@Model.DisplayOrder"></div>
                        }
                        <div class="mb-3 col-md-12">
                            <label class="form-check-label">Enabled</label>
                            <input asp-for="@Model.IsActive" type="checkbox" class="form-check-input" />
                        </div>
                        <div class="btn-group">
                            @if (Model.Id is > 0)
                            {
                                <button asp-action="Delete" asp-route-id="@Model.Id" onclick="return confirm('Are you sure you want to delete this entity?')" class="btn btn-danger">Delete</button>
                            }
                            <button type="submit" id="formsubmit" class="btn btn-primary">Save changes</button>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>