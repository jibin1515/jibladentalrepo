@model PartnerViewModel
@{
    var section = Model.Section;
}
@section Title
{
    Partners management
}
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-body" id="ModalUser">
                @using (Html.BeginForm("PostSection", "Partner", FormMethod.Post, new { enctype = "multipart/form-data" }))
                {
                    var Model = section!;
                    <div class="modal-body row">
                        <div class="mb-3 col-md-12">
                            <label class="col-form-label">Title(English)</label>
                            <input type="text" class="form-control" asp-for="@Model.TitleEnglish">
                        </div>
                        <div class="mb-3 col-md-12">
                            <label class="col-form-label">Title(Arabic)</label>
                            <input type="text" class="form-control" asp-for="@Model.TitleArabic" dir="rtl">
                        </div>
                        <div class="mb-3 col-md-12">
                            <label class="col-form-label">Body(English)</label>
                            <textarea class="mceDescrEng" asp-for="@Model.BodyEnglish"></textarea>
                        </div>
                        <div class="mb-3 col-md-12">
                            <label class="col-form-label">Body(Arabic)</label>
                            <textarea class="mceDescrArb" asp-for="@Model.BodyArabic" dir="rtl"></textarea>
                        </div>
                        <div class="mb-3 col-md-12">
                            <label class="col-form-label">Home Tagline(English)</label>
                            <input type="text" class="form-control" asp-for="@Model.HomeTaglineEnglish">
                        </div>
                        <div class="mb-3 col-md-12">
                            <label class="col-form-label">Home Tagline(Arabic)</label>
                            <input type="text" class="form-control" asp-for="@Model.HomeTaglineArabic" dir="rtl">
                        </div>
                        <div class="mb-3 col-md-12">
                            <label class="col-form-label">Home Title(English)</label>
                            <input type="text" class="form-control" asp-for="@Model.HomeTitleEnglish">
                        </div><div class="mb-3 col-md-12">
                            <label class="col-form-label">Home Title(Arabic)</label>
                            <input type="text" class="form-control" asp-for="@Model.HomeTitleArabic" dir="rtl">
                        </div>
                        <div class="mb-3 col-md-12">
                            <label class="col-form-label">Home Body(English)</label>
                            <textarea class="mceDescrEng" asp-for="@Model.HomeBodyEnglish"></textarea>
                        </div>
                        <div class="mb-3 col-md-12">
                            <label class="col-form-label">Home Body(Arabic)</label>
                            <textarea class="mceDescrArb" asp-for="@Model.HomeBodyArabic" dir="rtl"></textarea>
                        </div>
                        <div class="btn-group">
                            <button type="submit" id="formsubmit" class="btn btn-primary">Save changes</button>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h4 class="card-title">
                    Category
                </h4>
                <a asp-action="Get" asp-route-id="0" class="btn btn-primary btn-xs">New</a></div><div class="card-body">
                <table id="datatable" class="table table-striped dt-responsive nowrap w-100">
                    <thead><tr><th width="40%">Title</th><th width="20%">Status</th><th width="20%">Display Order</th><th width="20%">Action</th></tr></thead>
                    <tbody>
                        @foreach (var item in Model.PartnerCategorys)
                        {
                            <tr><td>@Html.Raw(item.TitleEnglish)</td><td>@Html.Raw(item.IsActive ? "Enabled" : "Disabled")</td><td>@Html.Raw(item.DisplayOrder)</td><td><a asp-action="Get" asp-route-id="@item.Id" class="btn btn-primary btn-xs"><i class="fas fa-pencil-alt"></i></a></td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>