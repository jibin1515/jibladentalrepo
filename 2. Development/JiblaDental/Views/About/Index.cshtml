@model HomeViewModel

@{
	var browserLang = Context.Request.Headers["Accept-Language"].ToString().Split(";").FirstOrDefault()?.Split(",").FirstOrDefault();
	var cultureCode = Context.Request.Cookies["CultureCode"] ?? (browserLang == "en" || browserLang == "ar" ? browserLang : "en");
	var cultureIsArabic = cultureCode == CultureCode.Arabic;
	var pageSettings = Model.Pages!.First(x => x.Name == "our-center");
	var about = Model.About!;
	var gallery = Model.AboutGalleries!;
	var testimonials = Model.Testimonials!;
}

@section seo {
    <link rel="stylesheet" href="/assets/css/splide.min.css" asp-append-version="true">
    <title> @Html.Raw(cultureIsArabic ? pageSettings.SeoTitleArabic : pageSettings.SeoTitleEnglish) </title>
    <meta name="description" content="@Html.Raw(cultureIsArabic ? pageSettings.SeoDescriptionArabic : pageSettings.SeoDescriptionEnglish)">
}

<div class="rs-breadcrumbs" style="background: url(@Html.Raw("/" + pageSettings.BannerImagePath));">
	<div class="container">
		<div class="breadcrumbs-inner">
			<h1 class="page-title">
				@Html.Raw(cultureIsArabic ? pageSettings.BannerTitleArabic : pageSettings.BannerTitleEnglish)
			</h1>
		</div>
	</div>
</div>

<div class="rs-project-details pt-100 md-pt-80">
	<div class="container">

		<div class="row">
			<div class="col-lg-4 md-mb-30 ceo_div">
				@if(!string.IsNullOrEmpty(about.CEOImagePath))
				{
				<img src="@Html.Raw("/" + about.CEOImagePath)" alt="@(about.CEOImageAlt ?? "")">
				}
				<h5>@Html.Raw(cultureIsArabic ? about.CEOTaglineArabic : about.CEOTaglineEnglish)</h5>
				<h3>@Html.Raw(cultureIsArabic ? about.CEONameArabic : about.CEONameEnglish)</h3>
			</div>
			<div class="col-lg-8 md-mb-30">
				<div class="project-content ceo_div">

					<p>@Html.Raw(cultureIsArabic ? about.CEOBodyArabic : about.CEOBodyEnglish)</p>

				</div>
			</div>


		</div>



	</div>
	<!-- Call To Action Choose Start -->

</div>


<div class="container mt-10">

	<div class="thumbnail_slider">
		<!-- Primary Slider Start-->
		<div id="primary_slider">
			<div class="splide__track">
				<ul class="splide__list">
					@foreach (var item in gallery)
					{
					<li class="splide__slide bigimg">
							<img src="@Html.Raw("/" + item.ImagePath)" alt="@(item.ImageAlt ?? "")">
					</li>
					}
				</ul>
			</div>
		</div>
		<!-- Primary Slider End-->
		<!-- Thumbnal Slider Start-->
		<div id="thumbnail_slider">
			<div class="splide__track">
				<ul class="splide__list">
					@foreach (var item in gallery)
					{
					<li class="splide__slide">
							<img src="@Html.Raw("/" + item.ImagePath)" alt="@(item.ImageAlt ?? "")">
					</li>
					}
				</ul>
			</div>
		</div>
		<!-- Thumbnal Slider End-->
	</div>

</div>

