@{
    var browserLang = Context.Request.Headers["Accept-Language"].ToString().Split(";").FirstOrDefault()?.Split(",").FirstOrDefault();
    var cultureCode = Context.Request.Cookies["CultureCode"] ?? (browserLang == "en" || browserLang == "ar" ? browserLang : "en");
    var isArabic = cultureCode == CultureCode.Arabic;
    var assetRoot = isArabic ? "/ar" : "";
    var rawPath = Context.Request.Path.Value ?? "/";
    var canonicalUrl = "https://www.jibladental.com" + (rawPath == "/" ? "/" : rawPath.TrimEnd('/'));
}
<!DOCTYPE html>
<html lang="@(isArabic ? "ar" : "en")" dir="@(isArabic ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8">
    <link rel="canonical" href="@canonicalUrl" />
    <link rel="alternate" hreflang="en" href="@canonicalUrl" />
    <link rel="alternate" hreflang="ar" href="@canonicalUrl" />
    <link rel="alternate" hreflang="x-default" href="@canonicalUrl" />
    <meta property="og:site_name" content="@(isArabic ? "مركز جبلة لطب الأسنان" : "Jibla Dental Center")" />
    <meta name="twitter:card" content="summary_large_image" />
    @await RenderSectionAsync("seo", false)

    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="shortcut icon" type="image/x-icon" href="/assets/images/fav.png">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preload" href="@assetRoot/assets/fonts/helvetica-neue/HelveticaNeueRoman.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="@assetRoot/assets/fonts/helvetica-neue/HelveticaNeueBold.woff2" as="font" type="font/woff2" crossorigin>

    @* Icon + button fonts are needed for first paint (the preloader waits for them); fetch them in parallel with the CSS *@
    <link rel="preload" href="@assetRoot/assets/fonts/webfonts/fa-solid-900.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="@assetRoot/assets/fonts/webfonts/fa-brands-400.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="@assetRoot/assets/fonts/uicons-regular-rounded.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="@assetRoot/assets/fonts/Flaticon.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="@assetRoot/assets/fonts/JF-Flat-regular.woff2" as="font" type="font/woff2" crossorigin>

    @* One minified bundle instead of 12 render-blocking stylesheets. Rebuild with 2. Development/tools (npm run build) *@
    <link rel="stylesheet" type="text/css" href="@assetRoot/assets/dist/site.min.css" asp-append-version="true">

    @* Non-critical CSS: loaded without blocking first paint *@
    <link rel="stylesheet" href="@assetRoot/assets/css/animate.css" asp-append-version="true" media="print" onload="this.media='all'">
    <link rel="stylesheet" href="@assetRoot/assets/css/magnific-popup.css" asp-append-version="true" media="print" onload="this.media='all'">
    <link rel="stylesheet" href="@assetRoot/assets/css/odometer.min.css" asp-append-version="true" media="print" onload="this.media='all'">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible+Next:ital,wght@0,200..800;1,200..800&display=swap" media="print" onload="this.media='all'">
    @if (cultureCode != CultureCode.English)
    {
        <link rel="stylesheet" href="https://fonts.googleapis.com/earlyaccess/droidarabickufi.css" media="print" onload="this.media='all'">
    }
    <noscript>
        <link rel="stylesheet" href="@assetRoot/assets/css/animate.css">
        <link rel="stylesheet" href="@assetRoot/assets/css/magnific-popup.css">
        <link rel="stylesheet" href="@assetRoot/assets/css/odometer.min.css">
    </noscript>

    @* Analytics/pixels are loaded after first user interaction (or 5s after load) so they don't compete with page rendering *@
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', 'G-Z73QC5YXXJ');
        (function () {
            var loaded = false;
            function add(src) {
                var el = document.createElement('script');
                el.async = true;
                el.src = src;
                document.head.appendChild(el);
            }
            function loadTracking() {
                if (loaded) return;
                loaded = true;
                add('https://www.googletagmanager.com/gtag/js?id=G-Z73QC5YXXJ');
                window.dataLayer.push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
                add('https://www.googletagmanager.com/gtm.js?id=GTM-MCHF697P');
                !function(f,b,e,v,n,t,s)
                {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
                n.callMethod.apply(n,arguments):n.queue.push(arguments)};
                if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
                n.queue=[];t=b.createElement(e);t.async=!0;
                t.src=v;s=b.getElementsByTagName(e)[0];
                s.parentNode.insertBefore(t,s)}(window, document,'script',
                'https://connect.facebook.net/en_US/fbevents.js');
                fbq('init', '2276832839415149');
                fbq('track', 'PageView');
            }
            ['scroll', 'mousemove', 'touchstart', 'keydown', 'click'].forEach(function (ev) {
                window.addEventListener(ev, loadTracking, { once: true, passive: true });
            });
            window.addEventListener('load', function () { setTimeout(loadTracking, 5000); });
        })();
    </script>
    <noscript>
        <img height="1" width="1" style="display:none"
             src="https://www.facebook.com/tr?id=2276832839415149&ev=PageView&noscript=1" />
    </noscript>
</head>
<body class="defult-home">

    <!-- Google Tag Manager (noscript) -->
    <noscript>
        <iframe src="https://www.googletagmanager.com/ns.html?id=GTM-MCHF697P"
                height="0" width="0" style="display:none;visibility:hidden"></iframe>
    </noscript>
    <!-- End Google Tag Manager (noscript) -->

    <div class="offwrap"></div>

    <div id="pre-load">
        <div id="loader" class="loader">
            <div class="loader-container">
                <div class="loader-icon"><img src="/assets/images/fav.png" alt="" width="94" height="94"></div>
            </div>
        </div>
    </div>

    <div class="main-content">

		
		@await Component.InvokeAsync("Header")

		<main>
		@RenderBody()
		</main>

        </div>

	@await Component.InvokeAsync("Footer")
    

    <div id="scrollUp">
        <i class="fa fa-angle-up"></i>
    </div>

    @* jquery, bootstrap, plugins, main2.js and main.js in one file (see 2. Development/tools) *@
    <script src="@assetRoot/assets/dist/site.min.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
