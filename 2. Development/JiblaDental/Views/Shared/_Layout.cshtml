@inject IWebHostEnvironment Env
@{
    var browserLang = Context.Request.Headers["Accept-Language"].ToString().Split(";").FirstOrDefault()?.Split(",").FirstOrDefault();
    var cultureCode = Context.Request.Cookies["CultureCode"] ?? (browserLang == "en" || browserLang == "ar" ? browserLang : "en");
    var isArabic = cultureCode == CultureCode.Arabic;
    var assetRoot = isArabic ? "/ar" : "";
    var rawPath = Context.Request.Path.Value ?? "/";
    // Home page: inline the above-the-fold CSS and load the full stylesheet without blocking the first paint
    var criticalCss = !isArabic && (Context.Request.Path.Value ?? "/") == "/" ? CriticalCss.Get(Env.WebRootPath) : null;
    var deferScripts = !string.IsNullOrEmpty(criticalCss);
    var canonicalUrl = "https://www.jibladental.com" + (rawPath == "/" ? "/" : rawPath.TrimEnd('/'));
}
<!DOCTYPE html>
<html lang="@(isArabic ? "ar" : "en")" dir="@(isArabic ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8">
    @* viewport must come before any <link rel="preload" imagesrcset/imagesizes ...>, otherwise "100vw" is resolved against a 980px viewport and the largest srcset candidate is fetched *@
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="canonical" href="@canonicalUrl" />
    <link rel="alternate" hreflang="en" href="@canonicalUrl" />
    <link rel="alternate" hreflang="ar" href="@canonicalUrl" />
    <link rel="alternate" hreflang="x-default" href="@canonicalUrl" />
    <meta property="og:site_name" content="@(isArabic ? "مركز جبلة لطب الأسنان" : "Jibla Dental Center")" />
    <meta name="twitter:card" content="summary_large_image" />
    @await RenderSectionAsync("seo", false)

    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <link rel="shortcut icon" type="image/x-icon" href="/assets/images/fav.png">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preload" href="@assetRoot/assets/fonts/helvetica-neue/HelveticaNeueRoman.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="@assetRoot/assets/fonts/helvetica-neue/HelveticaNeueBold.woff2" as="font" type="font/woff2" crossorigin>

    @* Fonts needed for the first paint (header icons, hero arrows, buttons); fetch them in parallel with the CSS *@
    <link rel="preload" href="@assetRoot/assets/fonts/webfonts/@(isArabic ? "fa-solid-900" : "fa-solid-subset").woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="@assetRoot/assets/fonts/Flaticon.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="@assetRoot/assets/fonts/JF-Flat-regular.woff2" as="font" type="font/woff2" crossorigin>

    @if (isArabic)
    {
        <link rel="stylesheet" type="text/css" href="/ar/assets/css/bootstrap.min.css" asp-append-version="true">
        <link rel="stylesheet" type="text/css" href="/ar/assets/fonts/font/font-awesome.min.css" asp-append-version="true">
        <link rel="stylesheet" type="text/css" href="/ar/assets/css/uicons-regular-rounded.css" asp-append-version="true">
        <link rel="stylesheet" type="text/css" href="/ar/assets/fonts/flaticon.css" asp-append-version="true">
        <link rel="stylesheet" type="text/css" href="/ar/assets/css/owl.carousel.css" asp-append-version="true">
        <link rel="stylesheet" type="text/css" href="/ar/assets/css/slick.css" asp-append-version="true">
        <link rel="stylesheet" type="text/css" href="/ar/assets/css/off-canvas.css" asp-append-version="true">
        <link rel="stylesheet" type="text/css" href="/ar/assets/css/rsmenu-main.css" asp-append-version="true">
        <link rel="stylesheet" type="text/css" href="/ar/assets/css/rs-spacing.css" asp-append-version="true">
        <link rel="stylesheet" type="text/css" href="/ar/assets/css/style2.min.css" asp-append-version="true">
        <link rel="stylesheet" type="text/css" href="/ar/style.min.css" asp-append-version="true">
        <link rel="stylesheet" type="text/css" href="/ar/assets/css/responsive.min.css" asp-append-version="true">
    }
    else if (!string.IsNullOrEmpty(criticalCss))
    {
        <style>@Html.Raw(criticalCss)</style>
        @* media="print" keeps the full stylesheet low priority and non-blocking; onload switches it on *@
        <link rel="stylesheet" type="text/css" href="/assets/dist/site.min.css" asp-append-version="true" media="print" onload="this.media='all'">
        <noscript><link rel="stylesheet" type="text/css" href="/assets/dist/site.min.css" asp-append-version="true"></noscript>
    }
    else
    {
        <link rel="stylesheet" type="text/css" href="/assets/dist/site.min.css" asp-append-version="true">
    }

    @* Non-critical CSS: loaded without blocking first paint *@
    <link rel="stylesheet" href="@assetRoot/assets/css/animate.css" asp-append-version="true" media="print" onload="this.media='all'">
    <link rel="stylesheet" href="@assetRoot/assets/css/magnific-popup.css" asp-append-version="true" media="print" onload="this.media='all'">
    <link rel="stylesheet" href="@assetRoot/assets/css/odometer.min.css" asp-append-version="true" media="print" onload="this.media='all'">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible+Next:ital,wght@0,200..800;1,200..800&display=swap" media="print" onload="this.media='all'">
    @if (cultureCode != CultureCode.English)
    {
        <link rel="stylesheet" href="https://fonts.googleapis.com/earlyaccess/droidarabickufi.css" media="print" onload="this.media='all'">
    }
    <noscript>
        <link rel="stylesheet" href="@assetRoot/assets/css/animate.css">
        <link rel="stylesheet" href="@assetRoot/assets/css/magnific-popup.css">
        <link rel="stylesheet" href="@assetRoot/assets/css/odometer.min.css">
    </noscript>

    @* Analytics/pixels (GTM, GA, Meta pixel) are loaded on the first user interaction so they don't compete with page rendering.
       Visitors who leave without scrolling/tapping are not counted; to also count them, re-add: window.addEventListener('load', function () { setTimeout(loadTracking, 5000); }); *@
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', 'G-Z73QC5YXXJ');
        (function () {
            var loaded = false;
            function add(src) {
                var el = document.createElement('script');
                el.async = true;
                el.src = src;
                document.head.appendChild(el);
            }
            function loadTracking() {
                if (loaded) return;
                loaded = true;
                add('https://www.googletagmanager.com/gtag/js?id=G-Z73QC5YXXJ');
                window.dataLayer.push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
                add('https://www.googletagmanager.com/gtm.js?id=GTM-MCHF697P');
                !function(f,b,e,v,n,t,s)
                {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
                n.callMethod.apply(n,arguments):n.queue.push(arguments)};
                if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
                n.queue=[];t=b.createElement(e);t.async=!0;
                t.src=v;s=b.getElementsByTagName(e)[0];
                s.parentNode.insertBefore(t,s)}(window, document,'script',
                'https://connect.facebook.net/en_US/fbevents.js');
                fbq('init', '2276832839415149');
                fbq('track', 'PageView');
            }
            ['scroll', 'mousemove', 'touchstart', 'keydown', 'click'].forEach(function (ev) {
                window.addEventListener(ev, loadTracking, { once: true, passive: true });
            });
        })();
    </script>
    <noscript>
        <img height="1" width="1" style="display:none"
             src="https://www.facebook.com/tr?id=2276832839415149&ev=PageView&noscript=1" />
    </noscript>
</head>
<body class="defult-home">

    <!-- Google Tag Manager (noscript) -->
    <noscript>
        <iframe src="https://www.googletagmanager.com/ns.html?id=GTM-MCHF697P"
                height="0" width="0" style="display:none;visibility:hidden"></iframe>
    </noscript>
    <!-- End Google Tag Manager (noscript) -->

    <div class="offwrap"></div>

    <div class="main-content">

		
		@await Component.InvokeAsync("Header")

		<main>
		@RenderBody()
		</main>

        </div>

	@await Component.InvokeAsync("Footer")
    

    <div id="scrollUp">
        <i class="fa fa-angle-up"></i>
    </div>

    @if (isArabic)
    {
        <script src="/ar/assets/js/jquery.min.js" asp-append-version="true"></script>
        <script src="/ar/assets/js/bootstrap.min.js" asp-append-version="true"></script>
        <script src="/ar/assets/js/jquery.nav.js" asp-append-version="true"></script>
        <script src="/ar/assets/js/jquery.malihu.PageScroll2id.min.js" asp-append-version="true"></script>
        <script src="/ar/assets/js/owl.carousel.min.js" asp-append-version="true"></script>
        <script src="/ar/assets/js/slick.min.js" asp-append-version="true"></script>
        <script src="/ar/assets/js/wow.min.js" asp-append-version="true"></script>
        <script src="/ar/assets/js/imagesloaded.pkgd.min.js" asp-append-version="true"></script>
        <script src="/ar/assets/js/jquery.appear.min.js" asp-append-version="true"></script>
        <script src="/ar/assets/js/odometer.min.js" asp-append-version="true"></script>
        <script src="/ar/assets/js/jquery.magnific-popup.min.js" asp-append-version="true"></script>
        <script src="/ar/assets/js/main2.js" asp-append-version="true"></script>
        <script src="/ar/assets/js/main.js" asp-append-version="true"></script>
    }
    else
    {
        @* Home page has no inline scripts that need jQuery, so the scripts can be deferred (they still run in order, before DOMContentLoaded) *@
        <script src="/assets/dist/site.core.min.js" asp-append-version="true" defer="@deferScripts"></script>
        <script src="/assets/dist/site.plugins.min.js" asp-append-version="true" defer="@deferScripts"></script>
        <script src="/assets/dist/site.app.min.js" asp-append-version="true" defer="@deferScripts"></script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
