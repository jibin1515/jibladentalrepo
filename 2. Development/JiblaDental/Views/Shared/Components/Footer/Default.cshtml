                                case "services":
                                case "team":
                                case "partners":
                                case "loyalty-program":
                                case "contact":
                                case "result":
                                case "error":
                                case "appointment":
                                    break;

                                default:
                                    <li><a href="@Html.Raw("/" + page.Name)">@Html.Raw(cultureCode == CultureCode.English ? page.TitleEnglish : page.TitleArabic)</a></li>
                                    break;
                            }
                        }
                    </ul>
                </div>
            </div>
            <div class="cs_footer_col addnewclass2 order-1">
                <div class="cs_footer_widget">
                    <h2 class="cs_footer_widget_title">@Html.Raw(cultureCode == CultureCode.English ? contact.FooterHeading1English : contact.FooterHeading1Arabic)</h2>
                    <ul class="cs_footer_widget_nav_list cs_mp_0">
                        <li><a>@Html.Raw(cultureCode == CultureCode.English ? contact.FooterTimingLabel1English : contact.FooterTimingLabel1Arabic)</a></li>
                        <li><a>@Html.Raw(cultureCode == CultureCode.English ? contact.FooterTimingLabel2English : contact.FooterTimingLabel2Arabic)</a></li>
                        <li><a>@Html.Raw(cultureCode == CultureCode.English ? contact.FooterTimingLabel3English : contact.FooterTimingLabel3Arabic)</a></li>
                        <li><a>@Html.Raw(cultureCode == CultureCode.English ? contact.FooterTimingLabel4English : contact.FooterTimingLabel4Arabic)</a></li>
                    </ul>
                    <div class="textwidget mt-20">
                        @if(!string.IsNullOrEmpty(contact.Certificate1ImagePath))
                        {
                            <img loading="lazy" decoding="async" src="@Html.Raw("/" + contact.Certificate1ImagePath)" alt="@(contact.Certificate1ImageAlt ?? "")">
                        }
                        @if (!string.IsNullOrEmpty(contact.Certificate2ImagePath))
                        {
                            <img loading="lazy" decoding="async" src="@Html.Raw("/" + contact.Certificate2ImagePath)" alt="@(contact.Certificate2ImageAlt ?? "")">
                        }
                        @if (!string.IsNullOrEmpty(contact.Certificate3ImagePath))
                        {
                            <img loading="lazy" decoding="async" src="@Html.Raw("/" + contact.Certificate3ImagePath)" alt="@(contact.Certificate3ImageAlt ?? "")">
                        }
                    </div>
                </div>

            </div>
        </div>
    </div>
    <div class="cs_footer_bottom cs_primary_bg">
        <div class="container">
            <div class="cs_footer_bottom_in text-center">
                <p class="cs_footer_copyright m-auto mb-0">© @DateTime.UtcNow.Year Jibla Dental Center. Designed By Uniweb IT Solutions</p>
            </div>
        </div>
    </div>
</footer>
