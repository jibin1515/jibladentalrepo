@model FooterViewModel
@{
    var browserLang = Context.Request.Headers["Accept-Language"].ToString().Split(";").FirstOrDefault()?.Split(",").FirstOrDefault();
    var cultureCode = Context.Request.Cookies["CultureCode"] ?? (browserLang == "en" || browserLang == "ar" ? browserLang : "en");
    var pages = Model.Pages!;
    var socialmedia = Model.SocialMedia!;
    var contact = Model.Contact!;
}

<footer class="cs_footer cs_blue_bg cs_bg_filed cs_white_color" data-src="/assets/images/footer-map.png">
    <div class="container">
        <div class="cs_footer_row">
            <div class="cs_footer_col">
                <div class="cs_footer_highlight_col cs_accent_bg">
                    <div class="cs_footer_logo">
                        <img loading="lazy" decoding="async" src="/assets/images/white-logo.png" alt="Jibla Dental Center">
                    </div>
                    @{
