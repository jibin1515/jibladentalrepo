                        </li>
                    </ul>
                    <div class="cs_social_btns cs_style_1">
                        @foreach (var item in socialmedia)
                        {
                            <a href="@item.Url" target="_blank" rel="noopener noreferrer" class="cs_center" aria-label="@item.Name"><i class="fa-brands fa-@Html.Raw(item.Name)"></i></a>
                        }
                    </div>
                </div>
            </div>
            <div class="cs_footer_col addnewclass order-2">
                <div class="cs_footer_widget">
                    <h2 class="cs_footer_widget_title">@Html.Raw(cultureCode == CultureCode.English ? contact.FooterHeading2English : contact.FooterHeading2Arabic)</h2>
                    <ul class="cs_footer_widget_nav_list cs_mp_0">
                        @foreach (var page in pages)
                        {
                            @switch (page.Name)
                            {
                                case "index":
                                case "privacy-policy":
                                case "faq":
                                case "news":
                                case "insurance":
                                case "video-hub":
                                case "careers":
                                case "result":
                                case "error":
                                case "appointment":
                                    break;

                                default:
                                    <li><a href="@Html.Raw("/" + page.Name)">@Html.Raw(cultureCode == CultureCode.English ? page.TitleEnglish : page.TitleArabic)</a></li>
                                    break;
                            }
                        }
                    </ul>
                </div>
            </div>
            <div class="cs_footer_col addnewclass order-3">
