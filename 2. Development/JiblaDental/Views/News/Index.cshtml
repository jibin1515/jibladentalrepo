@model HomeViewModel

@{
	var browserLang = Context.Request.Headers["Accept-Language"].ToString().Split(";").FirstOrDefault()?.Split(",").FirstOrDefault();
	var cultureCode = Context.Request.Cookies["CultureCode"] ?? (browserLang == "en" || browserLang == "ar" ? browserLang : "en");
	var cultureIsArabic = cultureCode == CultureCode.Arabic;
	var pageSettings = Model.Pages!.First(x => x.Name == "news");
}
@if (Model.IsDetails)
{
	@section seo {
	@{
		var newsTitle = cultureIsArabic ? Model.News.SeoTitleArabic : Model.News.SeoTitleEnglish;
		if (string.IsNullOrWhiteSpace(newsTitle))
		{
			newsTitle = cultureIsArabic ? Model.News.TitleArabic : Model.News.TitleEnglish;
		}
		var newsDesc = cultureIsArabic ? Model.News.SeoDescriptionArabic : Model.News.SeoDescriptionEnglish;
		if (string.IsNullOrWhiteSpace(newsDesc))
		{
			newsDesc = cultureIsArabic ? Model.News.ShortBodyArabic : Model.News.ShortBodyEnglish;
		}
		var newsImgPath = Model.NewsImages != null && Model.NewsImages.Any()
			? Model.NewsImages.First().ImagePath
			: (!string.IsNullOrEmpty(Model.News.HomeImagePath) ? Model.News.HomeImagePath : Model.News.BannerImagePath);
		var newsImgUrl = !string.IsNullOrEmpty(newsImgPath) ? ("https://www.jibladental.com/" + newsImgPath.TrimStart('/')) : "https://www.jibladental.com/assets/images/og-cover.jpg";
		var newsUrl = "https://www.jibladental.com/news/" + (Model.News.PageName ?? "");
		var headlineJson = System.Text.Json.JsonSerializer.Serialize(cultureIsArabic ? Model.News.TitleArabic ?? "" : Model.News.TitleEnglish ?? "");
		var descJson = System.Text.Json.JsonSerializer.Serialize(newsDesc ?? "");
		var postDate = cultureIsArabic ? Model.News.PostDateArabic : Model.News.PostDateEnglish;
	}
	<title> @Html.Raw(newsTitle) </title>
	<meta name="description" content="@Html.Raw(newsDesc)">
	<meta property="og:title" content="@Html.Raw(newsTitle)">
	<meta property="og:description" content="@Html.Raw(newsDesc)">
	<meta property="og:url" content="@newsUrl">
	<meta property="og:type" content="article">
	<meta property="og:image" content="@newsImgUrl">
	<meta name="twitter:card" content="summary_large_image">
	<meta name="twitter:title" content="@Html.Raw(newsTitle)">
	<meta name="twitter:description" content="@Html.Raw(newsDesc)">
	<meta name="twitter:image" content="@newsImgUrl">

	<script type="application/ld+json">
	{
	  "@@context": "https://schema.org",
	  "@@type": "BlogPosting",
	  "mainEntityOfPage": {
	    "@@type": "WebPage",
	    "@@id": "@newsUrl"
	  },
	  "headline": @Html.Raw(headlineJson),
	  "description": @Html.Raw(descJson),
	  "image": "@newsImgUrl",
	  "datePublished": "@Html.Raw(postDate)",
	  "author": {
	    "@@type": "Organization",
	    "name": "Jibla Dental Center",
	    "url": "https://www.jibladental.com/"
	  },
	  "publisher": {
	    "@@type": "Organization",
	    "name": "Jibla Dental Center",
	    "logo": {
	      "@@type": "ImageObject",
	      "url": "https://www.jibladental.com/assets/images/dark-logo.png"
	    }
	  }
	}
	</script>
	}

	<div class="rs-breadcrumbs" style="background: url(@Html.Raw("/" + Model.News.BannerImagePath));">
		<div class="container">
			<div class="breadcrumbs-inner">
				<h1 class="page-title">
					@Html.Raw(cultureIsArabic ? Model.News.BannerTitleArabic : Model.News.BannerTitleEnglish)
				</h1>
			</div>
		</div>
	</div>

	<div class="rs-inner-blog pt-120 pb-100 md-pt-80 md-pb-80">
		<div class="container">
			<div class="row justify-content-center">
				<div class="col-lg-10 md-mb-50">
					<div class="blog-details">

						<div class="blog-full text-center">
							<h3 class="blog-title">@Html.Raw(cultureIsArabic ? Model.News.TitleArabic : Model.News.TitleEnglish)</h3>
							<ul class="single-post-meta addblog1">
								<li>
									<span class="p-date"><i class="fi fi-rr-calendar"></i> @Html.Raw(cultureIsArabic ? Model.News.PostDateArabic : Model.News.PostDateEnglish) </span>
								</li>
							</ul>
							<p>@Html.Raw(cultureIsArabic ? Model.News.BodyArabic : Model.News.BodyEnglish)</p>



						</div>

						@if (Model.NewsImages.Count() > 0)
						{
							<div class="bs-img mb-35">
								<img src="@Html.Raw("/" + Model.NewsImages.FirstOrDefault().ImagePath)" alt="@(Model.NewsImages.FirstOrDefault().ImageAlt ?? (cultureIsArabic ? Model.News.TitleArabic : Model.News.TitleEnglish))">
							</div>
						}


					</div>
				</div>

			</div>

			<div class="row justify-content-center mt-2">

				@if (Model.NewsImages.Count() > 1)
				{
					foreach (var item in Model.NewsImages.Skip(1))
					{
						<div class="col-lg-5 md-mb-50">
							<div class="blog-details">
								<div class="bs-img mb-35">
									<img loading="lazy" decoding="async" src="@Html.Raw("/" + item.ImagePath)" alt="@(item.ImageAlt ?? (cultureIsArabic ? Model.News.TitleArabic : Model.News.TitleEnglish))">
								</div>
							</div>
						</div>
					}
				}

			</div>
		</div>
	</div>

}
else
{
	
	@section seo {
	<title> @Html.Raw(cultureIsArabic ? pageSettings.SeoTitleArabic : pageSettings.SeoTitleEnglish) </title>
	<meta name="description" content="@Html.Raw(cultureIsArabic ? pageSettings.SeoDescriptionArabic : pageSettings.SeoDescriptionEnglish)">
	<meta property="og:title" content="@Html.Raw(cultureIsArabic ? pageSettings.SeoTitleArabic : pageSettings.SeoTitleEnglish)">
	<meta property="og:description" content="@Html.Raw(cultureIsArabic ? pageSettings.SeoDescriptionArabic : pageSettings.SeoDescriptionEnglish)">
	<meta property="og:url" content="https://www.jibladental.com/news">
	<meta property="og:image" content="https://www.jibladental.com/assets/images/og-cover.jpg">
	<meta name="twitter:card" content="summary_large_image">
	<meta name="twitter:title" content="@Html.Raw(cultureIsArabic ? pageSettings.SeoTitleArabic : pageSettings.SeoTitleEnglish)">
	<meta name="twitter:description" content="@Html.Raw(cultureIsArabic ? pageSettings.SeoDescriptionArabic : pageSettings.SeoDescriptionEnglish)">
	<meta name="twitter:image" content="https://www.jibladental.com/assets/images/og-cover.jpg">
	}

	<div class="rs-breadcrumbs" style="background: url(@Html.Raw("/" + pageSettings.BannerImagePath));">
		<div class="container">
			<div class="breadcrumbs-inner">
				<h1 class="page-title">
					@Html.Raw(cultureIsArabic ? pageSettings.BannerTitleArabic : pageSettings.BannerTitleEnglish)
				</h1>
			</div>
		</div>
	</div>

	<div class="rs-inner-blog pt-120 pb-120 md-pt-80 md-pb-80">
		<div class="container">
			<div class="row">
				<div class="col-lg-12 md-mb-50">
					<div class="row">
						@foreach(var item in Model.NewsList)
						{
						<div class="col-lg-6 mb-50">
							<div class="blog-item">
								<div class="blog-img">
									<a asp-action="Index" asp-controller="News" asp-route-url="@item.PageName"><img loading="lazy" decoding="async" src="@Html.Raw("/" + item.HomeImagePath)" alt="@(item.HomeImageAlt ?? "")"></a>
								</div>
								<div class="blog-content">
										<h3 class="blog-title"><a asp-action="Index" asp-controller="News" asp-route-url="@item.PageName">@Html.Raw(cultureIsArabic ? item.TitleArabic : item.TitleEnglish)</a></h3>
									<div class="blog-meta">
										<ul class="btm-cate pb-0">
											<li>
												<div class="blog-date pb-1">
														<i class="fi fi-rr-calendar"></i> @Html.Raw(cultureIsArabic ? item.PostDateArabic : item.PostDateEnglish)
												</div>
											</li>
										</ul>
									</div>
										<div class="blog-desc">@Html.Raw(cultureIsArabic ? item.ShortBodyArabic : item.ShortBodyEnglish)</div>
									<div class="btn-part mt-15 md-mt-15">
											<a class="readon details" asp-action="Index" asp-controller="News" asp-route-url="@item.PageName">@Html.Raw(cultureIsArabic ? "اكتشف المزيد" : "Discover more")</a>
									</div>
								</div>
							</div>
						</div>
						}
					</div>
				</div>

			</div>
		</div>
	</div>

}