@model HomeViewModel

@{
	var browserLang = Context.Request.Headers["Accept-Language"].ToString().Split(";").FirstOrDefault()?.Split(",").FirstOrDefault();
	var cultureCode = Context.Request.Cookies["CultureCode"] ?? (browserLang == "en" || browserLang == "ar" ? browserLang : "en");
	var cultureIsArabic = cultureCode == CultureCode.Arabic;
	var pageSettings = Model.Pages!.First(x => x.Name == "careers");
	int i = 0;
	var enquiry = Model.Enquiry!;
	var section = Model.CareerSection!;
}
@if (Model.IsDetails)
{
	var career = Model.Career!;
	@section seo {
	<script src="https://www.google.com/recaptcha/api.js" async defer></script>
	<title> @Html.Raw(cultureIsArabic ? career.SeoTitleArabic : career.SeoTitleEnglish) </title>
	<meta name="description" content="@Html.Raw(cultureIsArabic ? career.SeoDescriptionArabic : career.SeoDescriptionEnglish)">
	}

	<div class="rs-breadcrumbs" style="background: url(@Html.Raw("/" + pageSettings.BannerImagePath));">
		<div class="container">
			<div class="breadcrumbs-inner">
				<h1 class="page-title">
					@Html.Raw(cultureIsArabic ? pageSettings.BannerTitleArabic : pageSettings.BannerTitleEnglish)
				</h1>
			</div>
		</div>
	</div>

	<div class="rs-careers-single pt-120 pb-100 md-pt-80 md-pb-80">
		<div class="container">
			<div class="row">
				<div class="col-lg-8 pr-45 md-pr-15 md-mb-50">
					<div class="career-inner-section">
						<div class="career-wrap">
							<div class="row">
								<div class="col-lg-6">
									<div class="title-inner">
										<div class="description">
											<p><strong>@Html.Raw(cultureIsArabic ? "فئة الوظيفة:" : "Job Category:")</strong> @Html.Raw(cultureIsArabic ? Model.Career.TitleArabic : Model.Career.TitleEnglish)<br><strong>@Html.Raw(cultureIsArabic ? "بريد إلكتروني:" : "Email:")</strong> @Html.Raw(Model.Career.Email)</p>
										</div>
									</div>
								</div>
								<div class="col-lg-6">
									<div class="title-inner">
										<div class="description">
											<p><strong>@Html.Raw(cultureIsArabic ? "نوع الوظيفة:" : "Job Type:")</strong> @Html.Raw(cultureIsArabic ? Model.Career.JobTypeArabic : Model.Career.JobTypeEnglish)
												@* <br><strong>@Html.Raw(cultureIsArabic ? "خالي:" : "Vacancy:")</strong> @Html.Raw(Model.Career.Vacancy) *@
												</p>
										</div>
									</div>
								</div>
							</div>
						</div>
						@* <div class="career-img">
							<img src="/assets/images/appointment/1.jpg" alt="">
						</div> *@

						<p class="desc pt-35 pb-60">@Html.Raw(cultureIsArabic ? Model.Career.BodyArabic : Model.Career.BodyEnglish)</p>

						<h2 class="title pb-10">@Html.Raw(cultureIsArabic ? Model.Career.Title2Arabic : Model.Career.Title2English)</h2>

						<p>@Html.Raw(cultureIsArabic ? Model.Career.Body2Arabic : Model.Career.Body2English)</p>
						<h2 class="title pt-30 pb-30">@Html.Raw(cultureIsArabic ? Model.Career.Title3Arabic : Model.Career.Title3English)</h2>
						<p>@Html.Raw(cultureIsArabic ? Model.Career.Body3Arabic : Model.Career.Body3English)</p>
						@foreach(var item in Model.CareerContents)
						{
							<h2 class="title pt-30 pb-30">@Html.Raw(cultureIsArabic ? item.TitleArabic : item.TitleEnglish)</h2>
							<p>@Html.Raw(cultureIsArabic ? item.BodyArabic : item.BodyEnglish)</p>
						}
					</div>
				</div>
				<div class="col-lg-4">
					<div class="contact-wrap">
						<div class="title-inner">
							<h2 class="title">@Html.Raw(cultureIsArabic ? "التقدم لهذا المنصب" : "Apply for this position")</h2>
						</div>
						@using (Html.BeginForm("PostEnquiry", "Careers", FormMethod.Post, new { enctype = "multipart/form-data", @class = "" }))
						{
							var Model = enquiry;
							<fieldset>
								<input type="hidden" value="@career.Id" id="EntityId" name="EntityId" />
								<div class="row">
									<div class="col-lg-12 mb-25">
										<input class="from-control" type="text" asp-for="@Model.FirstName" placeholder="@Html.Raw(cultureIsArabic ? "الاسم الأول" : "First Name")" aria-label="@Html.Raw(cultureIsArabic ? "الاسم الأول" : "First Name")" required>
									</div>
									<div class="col-lg-12 mb-25">
										<input class="from-control" type="text" asp-for="@Model.LastName" placeholder="@Html.Raw(cultureIsArabic ? "اسم العائلة" : "Last Name")" aria-label="@Html.Raw(cultureIsArabic ? "اسم العائلة" : "Last Name")" required>
									</div>
									<div class="col-lg-12 mb-25">
										<input class="from-control" type="email" asp-for="@Model.Email" placeholder="@Html.Raw(cultureIsArabic ? "بريد إلكتروني" : "Email")" aria-label="@Html.Raw(cultureIsArabic ? "بريد إلكتروني" : "Email")" required>
									</div>
									<div class="col-lg-12 mb-25">
										<input class="from-control" type="tel" inputmode="tel" autocomplete="tel" asp-for="@Model.Phone" placeholder="@Html.Raw(cultureIsArabic ? "هاتف" : "Phone")" aria-label="@Html.Raw(cultureIsArabic ? "هاتف" : "Phone")" required>
									</div>
									<div class="col-lg-12 mb-25">
<<<<<<< Updated upstream
										<input class="from-control" type="file" accept=".pdf,.doc,.docx" asp-for="@Model.AttachedFile" placeholder="@Html.Raw(cultureIsArabic ? "السيرة الذاتية" : "Cv")" aria-label="@Html.Raw(cultureIsArabic ? "السيرة الذاتية" : "Cv")" required>
=======
										<input class="from-control" type="file" asp-for="@Model.AttachedFile" accept=".pdf,.doc,.docx" placeholder="@Html.Raw(cultureIsArabic ? "السيرة الذاتية" : "Cv")" required>
>>>>>>> Stashed changes
									</div>
									<div class="col-lg-12 mb-25">
										<textarea class="from-control" asp-for="@Model.Message" placeholder="@Html.Raw(cultureIsArabic ? "رسالة" : "Message")" aria-label="@Html.Raw(cultureIsArabic ? "رسالة" : "Message")"></textarea>
									</div>
									<div class="col-lg-12 mb-25">
							<div class="g-recaptcha" data-sitekey="6Le7qz8rAAAAABC2ThhpbGOXJSOEbtHYPTu8xOs2"></div>
										@Html.ValidationMessage("ValidationErrors", new { @class = "text-danger" })
									</div>
								</div>
								<div class="btn-part">
									<div class="form-group mb-0">
										<input class="readon details submit2" type="submit" value="@Html.Raw(cultureIsArabic ? "أرسل الآن" : "Submit Now")">
									</div>
								</div>
							</fieldset>
						}
						<div id="form-messages"></div>
					</div>

				</div>
			</div>
		</div>
	</div>

}
else
{

	@section seo {
	<title> @Html.Raw(cultureIsArabic ? pageSettings.SeoTitleArabic : pageSettings.SeoTitleEnglish) </title>
	<meta name="description" content="@Html.Raw(cultureIsArabic ? pageSettings.SeoDescriptionArabic : pageSettings.SeoDescriptionEnglish)">
	}

	<div class="rs-breadcrumbs" style="background: url(@Html.Raw("/" + pageSettings.BannerImagePath));">
		<div class="container">
			<div class="breadcrumbs-inner">
				<h1 class="page-title">
					@Html.Raw(cultureIsArabic ? pageSettings.BannerTitleArabic : pageSettings.BannerTitleEnglish)
				</h1>
			</div>
		</div>
	</div>

	<div class="rs-services services-style5 services-carrers-modify1 pt-120 pb-170 md-pt-80 sm-pt-80 sm-pb-80">
		<div class="container">
			<div class="row">
				<div class="col-lg-12 text-center">
					<div class="sec-title mb-65 md-mb-30">
						<h2 class="title title3">
							@Html.Raw(cultureIsArabic ? section.TitleArabic : section.TitleEnglish)
							@* @Html.Raw(cultureIsArabic ? "فرص العمل" : "Job Opportunities") *@
						</h2>
					</div>
				</div>
			</div>
			<div class="row">
				@foreach(var item in Model.Careers)
				{
					i++;
				<div class="col-lg-4 col-md-6 mb-20">
					<div class="services-item">
						<div class="services-wrap">
							<div class="services-icon">
								<img loading="lazy" decoding="async" src="@Html.Raw("/" + item.IconPath)" alt="@(item.IconAlt ?? "")">
							</div>
							<div class="services-text">
									<h2 class="title">@Html.Raw(cultureIsArabic ? item.TitleArabic : item.TitleEnglish)</h2>
									<p class="services-txt">@Html.Raw(cultureIsArabic ? item.ShortBodyArabic : item.ShortBodyEnglish)</p>
								<div class="services-btn">
										<a class="readon read-more apply" asp-action="Index" asp-controller="Careers" asp-route-url="@item.PageName">@Html.Raw(cultureIsArabic ? "تقدم بطلبك الآن" : "Apply Now")<i class="fa fa fa-angle-right"></i></a>
								</div>
								@* <div class="serial-number">@Html.Raw(i < 10 ? "0"+i:i) </div> *@
							</div>
						</div>
					</div>
				</div>
				}
			</div>
		</div>
	</div>

}