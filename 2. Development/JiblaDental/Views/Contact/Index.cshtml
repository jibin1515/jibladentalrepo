@model HomeViewModel

@{
	var browserLang = Context.Request.Headers["Accept-Language"].ToString().Split(";").FirstOrDefault()?.Split(",").FirstOrDefault();
	var cultureCode = Context.Request.Cookies["CultureCode"] ?? (browserLang == "en" || browserLang == "ar" ? browserLang : "en");
	var cultureIsArabic = cultureCode == CultureCode.Arabic;
	var pageSettings = Model.Pages!.First(x => x.Name == "contact");
	var contact = Model.Contact!;
	var enquiry = Model.Enquiry!;
}

@section seo {
	<title> @Html.Raw(cultureIsArabic ? pageSettings.SeoTitleArabic : pageSettings.SeoTitleEnglish) </title>
	<meta name="description" content="@Html.Raw(cultureIsArabic ? pageSettings.SeoDescriptionArabic : pageSettings.SeoDescriptionArabic)">
}

<div class="rs-breadcrumbs" style="background: url(@Html.Raw("/" + pageSettings.BannerImagePath));">
	<div class="container">
		<div class="breadcrumbs-inner">
			<h1 class="page-title">
				@Html.Raw(cultureIsArabic ? pageSettings.BannerTitleArabic : pageSettings.BannerTitleEnglish)
			</h1>
		</div>
	</div>
</div>

<div class="rs-contact contact-style1 contact-modify1 gray-bg2 pt-120 pb-120 md-pt-80">
	<div class="container">
		<div class="row no-gutters">
			<div class="col-lg-6">
				<div class="address-wrap-section">
					<div class="sec-title2 mb-0 contactdiv">
						<h1 class="title title-color pb-20">@Html.Raw(cultureIsArabic ? contact.TitleArabic : contact.TitleEnglish)</h1>
					</div>
					@{
						var googleMapUrl = !string.IsNullOrEmpty(contact.GoogleMapLink) 
							? contact.GoogleMapLink 
							: "https://www.google.com/maps/place/Jibla+Dental+Center/@29.3615613,47.9663589,21z/data=!4m6!3m5!1s0x3fcf857cccafdb91:0x1335cbd64b39c67b!8m2!3d29.3614915!4d47.9663954!16s%2Fg%2F11rsfbt_rz?entry=ttu&g_ep=EgoyMDI2MDkyMC4wIKXMDSoASAFQAw%3D%3D";
					}
					<div class="row mt-30">
						<div class="col-lg-12 mb-20">
							<div class="address-item">
								<div class="address-icon">
									<a href="@googleMapUrl" target="_blank">
										<img src="/assets/images/contact/icons/2.png" alt="Images">
									</a>
								</div>
								<div class="address-text">
									<h4 class="title">@Html.Raw(cultureIsArabic ? "عنوان" : "Address")</h4>
									<p class="address-txt">
										<a href="@googleMapUrl" target="_blank" style="color: inherit;">
											@Html.Raw(cultureIsArabic ? contact.AddressArabic : contact.AddressEnglish)
										</a>
									</p>
								</div>
							</div>
						</div>
						<div class="col-lg-12 mb-20">
							<div class="address-item">
								<div class="address-icon">
									<img src="/assets/images/contact/icons/3.png" alt="Images">
								</div>
								<div class="address-text">
									<h4 class="title">@Html.Raw(cultureIsArabic ? "راسلنا عبر البريد الإلكتروني" : "Email us")</h4>
									<p class="address-txt">
										@Html.Raw(contact.Email1)<br>
										@Html.Raw(contact.Email2)
									</p>
								</div>
							</div>
						</div>
						<div class="col-lg-12">
							<div class="address-item">
								<div class="address-icon">
									<img src="/assets/images/contact/icons/4.png" alt="Images">
								</div>
								<div class="address-text">
									<h4 class="title">@Html.Raw(cultureIsArabic ? "اتصل بنا" : "Call us")</h4>
									<p class="address-txt">
										@Html.Raw(contact.Phone1)<br>
										@Html.Raw(contact.Phone2)
									</p>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
			<div class="col-lg-6">
				<div class="contact-section">
					<div class="sec-title2 mb-35">
						<h1 class="title text-center">@Html.Raw(cultureIsArabic ? contact.FormTitleArabic : contact.FormTitleEnglish)</h1>
					</div>
					<div class="contact-wrap">
						@using (Html.BeginForm("PostEnquiry", "Contact", FormMethod.Post, new { enctype = "multipart/form-data", @class = "" }))
						{
							var Model = enquiry;
							<fieldset>
								<div class="row">
									<div class="col-lg-6 col-md-6 col-sm-6 mb-25">
										<input class="from-control" type="text" asp-for="@Model.Name" placeholder="@Html.Raw(cultureIsArabic ? "اسم" : "Name")" required>
									</div>
									<div class="col-lg-6 col-md-6 col-sm-6 mb-25">
										<input class="from-control" type="email" asp-for="@Model.Email" placeholder="@Html.Raw(cultureIsArabic ? "بريد إلكتروني" : "Email")" required>
									</div>
									<div class="col-lg-6 col-md-6 col-sm-6 mb-25">
										<input class="from-control" type="number" asp-for="@Model.Phone" placeholder="@Html.Raw(cultureIsArabic ? "رقم التليفون" : "Phone Number")" required>
									</div>
									<div class="col-lg-6 col-md-6 col-sm-6 mb-25">
										<input class="from-control" type="text" asp-for="@Model.Subject" placeholder="@Html.Raw(cultureIsArabic ? "موضوع" : "Subject")">
									</div>
									<div class="col-lg-12 mb-30">
										<textarea class="from-control" asp-for="@Model.Message" placeholder="@Html.Raw(cultureIsArabic ? "رسالتك هنا" : "Your Message Here")"></textarea>
									</div>
									<div class="col-lg-12 mb-30">
								<div class="g-recaptcha" data-sitekey=6Le7qz8rAAAAABC2ThhpbGOXJSOEbtHYPTu8xOs2></div>
										@Html.ValidationMessage("ValidationErrors", new { @class = "text-danger" })
									</div>
								</div>
								<div class="btn-part">
									<div class="form-group mb-0">
										<input class="readon details submit" type="submit" value="@Html.Raw(cultureIsArabic ? "أرسل الآن" : "Submit Now")">
									</div>
								</div>
							</fieldset>
						}
						<div id="form-messages"></div>
					</div>
				</div>
			</div>
		</div>
	</div>

</div>