@model HomeViewModel

@{
    var browserLang = Context.Request.Headers["Accept-Language"].ToString().Split(";").FirstOrDefault()?.Split(",").FirstOrDefault();
    var cultureCode = Context.Request.Cookies["CultureCode"] ?? (browserLang == "en" || browserLang == "ar" ? browserLang : "en");
    var cultureIsArabic = cultureCode == CultureCode.Arabic;
    var pageSettings = Model.Pages!.First(x => x.Name == "faq");
    var faq = Model.Faq!;
    int i = 0;
}

@section seo {
	<title> @Html.Raw(cultureIsArabic ? pageSettings.SeoTitleArabic : pageSettings.SeoTitleEnglish) </title>
	<meta name="description" content="@Html.Raw(cultureIsArabic ? pageSettings.SeoDescriptionArabic : pageSettings.SeoDescriptionEnglish)">
}

<div class="rs-breadcrumbs" style="background: url(@Html.Raw("/" + pageSettings.BannerImagePath));">
	<div class="container">
		<div class="breadcrumbs-inner">
			<h1 class="page-title">
				@Html.Raw(cultureIsArabic ? pageSettings.BannerTitleArabic : pageSettings.BannerTitleEnglish)
			</h1>
		</div>
	</div>
</div>

<div class="rs-faq faq-style1 faq-modify1 pt-120 pb-120 md-pt-80 md-pb-80">
    <div class="container">
        <div class="row">
            <div class="col-lg-12 pr-60 md-pr-15 md-mb-50">
                <div class="faq-content">
                    <div id="accordion" class="accordion">
                        @foreach(var item in faq)
                        {
                            i++;
                            <div class="card">
                            <div class="card-header">
                                    <a class="card-link" href="#" data-bs-toggle="collapse" data-bs-target="#collapse-@i" aria-expanded="@Html.Raw(i == 1 ? "true" : "false")">@Html.Raw(cultureIsArabic ? item.TitleArabic : item.TitleEnglish)</a>
                            </div>
                            <div id="collapse-@i" class="collapse @Html.Raw(i == 1 ? "show" : "")" data-bs-parent="#accordion">
                                <div class="card-body">
                                        @Html.Raw(cultureIsArabic ? item.BodyArabic : item.BodyEnglish)
                                </div>
                            </div>
                        </div>
                        }
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>