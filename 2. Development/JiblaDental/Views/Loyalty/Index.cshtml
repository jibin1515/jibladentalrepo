@model HomeViewModel

@{
	var browserLang = Context.Request.Headers["Accept-Language"].ToString().Split(";").FirstOrDefault()?.Split(",").FirstOrDefault();
	var cultureCode = Context.Request.Cookies["CultureCode"] ?? (browserLang == "en" || browserLang == "ar" ? browserLang : "en");
	var cultureIsArabic = cultureCode == CultureCode.Arabic;
	var pageSettings = Model.Pages!.First(x => x.Name == "loyalty-program");
}
@if (Model.IsDetails)
{

	@section seo {
	<title> @Html.Raw(cultureIsArabic ? Model.Loyalty.SeoTitleArabic : Model.Loyalty.SeoTitleEnglish) </title>
	<meta name="description" content="@Html.Raw(cultureIsArabic ? Model.Loyalty.SeoDescriptionArabic : Model.Loyalty.SeoDescriptionEnglish)">
	<meta property="og:title" content="@Html.Raw(cultureIsArabic ? Model.Loyalty.SeoTitleArabic : Model.Loyalty.SeoTitleEnglish)">
	<meta property="og:description" content="@Html.Raw(cultureIsArabic ? Model.Loyalty.SeoDescriptionArabic : Model.Loyalty.SeoDescriptionEnglish)">
	<meta property="og:url" content="https://www.jibladental.com/loyalty/@Model.Loyalty.PageName">
	<meta property="og:image" content="https://www.jibladental.com/assets/images/og-cover.jpg">
	<meta name="twitter:card" content="summary_large_image">
	<meta name="twitter:title" content="@Html.Raw(cultureIsArabic ? Model.Loyalty.SeoTitleArabic : Model.Loyalty.SeoTitleEnglish)">
	<meta name="twitter:description" content="@Html.Raw(cultureIsArabic ? Model.Loyalty.SeoDescriptionArabic : Model.Loyalty.SeoDescriptionEnglish)">
	<meta name="twitter:image" content="https://www.jibladental.com/assets/images/og-cover.jpg">
	}

	<div class="rs-breadcrumbs" style="background: url(@Html.Raw("/" + Model.Loyalty.BannerImagePath));">
		<div class="container">
			<div class="breadcrumbs-inner">
				<h1 class="page-title">
					@Html.Raw(cultureIsArabic ? Model.Loyalty.BannerTitleArabic : Model.Loyalty.BannerTitleEnglish)
				</h1>
			</div>
		</div>
	</div>

	<div class="rs-inner-blog pt-120 pb-100 md-pt-80 md-pb-80">
		<div class="container">
			<div class="row justify-content-center">
				<div class="col-lg-10 md-mb-50">
					<div class="blog-details">

						<div class="blog-full text-center">
							<h3 class="blog-title">@Html.Raw(cultureIsArabic ? Model.Loyalty.TitleArabic : Model.Loyalty.TitleEnglish)</h3>
							<div class="row">
								@* <div class="col-lg-12 loyaltydiv">
							<p>@Html.Raw(cultureIsArabic ? Model.Loyalty.BodyArabic : Model.Loyalty.BodyEnglish)</p>
								</div> *@

								<div class="col-lg-12 md-mb-50 check-lists check-modify1">
									
									@Html.Raw(cultureIsArabic ? Model.Loyalty.BodyArabic : Model.Loyalty.BodyEnglish)
									
								</div>							

							</div>
						</div>
						@if (Model.LoyaltyImages.Count() > 0)
						{
						<div class="bs-img mb-35">
								<img src="@Html.Raw("/" + Model.LoyaltyImages.FirstOrDefault().ImagePath)" alt="@(Model.LoyaltyImages.FirstOrDefault().ImageAlt ?? "")">
						</div>
						}

					</div>
				</div>

			</div>

			<div class="row justify-content-center mt-2">
				@if (Model.LoyaltyImages.Count() > 1)
				{
					foreach (var item in Model.LoyaltyImages.Skip(1))
					{
						<div class="col-lg-5 md-mb-50">
							<div class="blog-details">
								<div class="bs-img mb-35">
									<img loading="lazy" decoding="async" src="@Html.Raw("/" + item.ImagePath)" alt="@(item.ImageAlt ?? "")">
								</div>
							</div>
						</div>
					}
				}
			</div>
		</div>
	</div>

}
else
{

	@section seo {
	<title> @Html.Raw(cultureIsArabic ? pageSettings.SeoTitleArabic : pageSettings.SeoTitleEnglish) </title>
	<meta name="description" content="@Html.Raw(cultureIsArabic ? pageSettings.SeoDescriptionArabic : pageSettings.SeoDescriptionEnglish)">
	<meta property="og:title" content="@Html.Raw(cultureIsArabic ? pageSettings.SeoTitleArabic : pageSettings.SeoTitleEnglish)">
	<meta property="og:description" content="@Html.Raw(cultureIsArabic ? pageSettings.SeoDescriptionArabic : pageSettings.SeoDescriptionEnglish)">
	<meta property="og:url" content="https://www.jibladental.com/loyalty">
	<meta property="og:image" content="https://www.jibladental.com/assets/images/og-cover.jpg">
	<meta name="twitter:card" content="summary_large_image">
	<meta name="twitter:title" content="@Html.Raw(cultureIsArabic ? pageSettings.SeoTitleArabic : pageSettings.SeoTitleEnglish)">
	<meta name="twitter:description" content="@Html.Raw(cultureIsArabic ? pageSettings.SeoDescriptionArabic : pageSettings.SeoDescriptionEnglish)">
	<meta name="twitter:image" content="https://www.jibladental.com/assets/images/og-cover.jpg">
	}

	<div class="rs-breadcrumbs" style="background: url(@Html.Raw("/" + pageSettings.BannerImagePath));">
		<div class="container">
			<div class="breadcrumbs-inner">
				<h1 class="page-title">
					@Html.Raw(cultureIsArabic ? pageSettings.BannerTitleArabic : pageSettings.BannerTitleEnglish)
				</h1>
			</div>
		</div>
	</div>

	<div class="rs-about about-style2 pt-120 pb-120 md-pt-80 md-pb-80">
		<div class="container">
			@foreach(var item in Model.Loyalties)
			{
			<div class="row y-middle mt-0">
				<div class="col-lg-6 md-mb-50">
						<div class="sec-title mb-10 check-lists">
						<h2 class="title title2 title-color pb-20">
								@Html.Raw(cultureIsArabic ? item.TitleArabic : item.TitleEnglish)
						</h2>
							<p class="desc small2">@Html.Raw(cultureIsArabic ? item.ShortBodyArabic : item.ShortBodyEnglish)</p>
					</div>
					<div class="btn-part mt-10 md-mt-15">
							<a class="readon details" asp-action="Index" asp-controller="Loyalty" asp-route-url="@item.PageName">@Html.Raw(cultureIsArabic ? "اكتشف المزيد" : "Discover More")</a>
					</div>
				</div>
				@if(!string.IsNullOrEmpty(item.HomeImagePath))
				{
				<div class="col-lg-6">
					<div class="appoach-img wow fadeInRight" data-wow-duration="1.5s" data-wow-delay="0s">
						<img loading="lazy" decoding="async" src="@Html.Raw("/" + item.HomeImagePath)" alt="@(item.HomeImageAlt ?? "")">
					</div>
				</div>
				}
			</div>
			}
		</div>
	</div>

}